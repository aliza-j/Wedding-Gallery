<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Siti & Harith — Wedding Gallery & Guestbook</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600&family=Great+Vibes&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        wedding: {
                            blush: '#FDF0F0',
                            rose: '#E8B4B8',
                            gold: '#D4AF37',
                            goldLight: '#F3E5AB',
                            champagne: '#F7E7CE',
                            burgundy: '#6B2D3A',
                            dark: '#2C2224',
                            sage: '#8A9A86'
                        }
                    },
                    fontFamily: {
                        serif: ['Cormorant Garamond', 'serif'],
                        sans: ['Montserrat', 'sans-serif'],
                        cursive: ['Great Vibes', 'cursive']
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Custom scrollbar & aesthetics */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #FDF0F0;
        }
        ::-webkit-scrollbar-thumb {
            background: #E8B4B8;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }

        /* Photo Filters */
        .filter-normal { filter: none; }
        .filter-vintage { filter: sepia(0.4) contrast(1.1) brightness(0.95) saturate(1.2); }
        .filter-bw { filter: grayscale(1) contrast(1.2); }
        .filter-sepia { filter: sepia(0.8) hue-rotate(-10deg); }
        .filter-vivid { filter: saturate(1.8) contrast(1.05); }
        .filter-warm { filter: sepia(0.25) saturate(1.3) hue-rotate(-5deg); }

        /* Floating Hearts Animation */
        @keyframes floatUp {
            0% { transform: translateY(0) scale(0.8) rotate(0deg); opacity: 0; }
            20% { opacity: 0.8; }
            100% { transform: translateY(-100vh) scale(1.2) rotate(360deg); opacity: 0; }
        }
        .floating-heart {
            position: fixed;
            bottom: -20px;
            pointer-events: none;
            z-index: 0;
            animation: floatUp 8s linear infinite;
        }

        /* Glassmorphism */
        .glass-panel {
            background: rgba(255, 255, 255, 0.82);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(212, 175, 55, 0.25);
        }

        /* Polaroid styling */
        .polaroid-card {
            background: #ffffff;
            box-shadow: 0 10px 25px -5px rgba(107, 45, 58, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .polaroid-card:hover {
            transform: translateY(-6px) rotate(0.5deg);
            box-shadow: 0 20px 30px -10px rgba(107, 45, 58, 0.18);
        }

        /* Pulsing camera ring */
        @keyframes ringPulse {
            0% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.5); }
            70% { box-shadow: 0 0 0 15px rgba(212, 175, 55, 0); }
            100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); }
        }
        .shutter-btn {
            animation: ringPulse 2s infinite;
        }
    </style>
</head>
<body class="bg-wedding-blush text-wedding-dark font-sans min-h-screen relative overflow-x-hidden">

    <!-- Floating Background Decorative Elements -->
    <div id="floating-hearts-container" class="fixed inset-0 pointer-events-none overflow-hidden z-0"></div>

    <!-- Header / Hero Banner -->
    <header class="relative z-10 pt-10 pb-8 px-4 text-center bg-gradient-to-b from-white via-wedding-blush/60 to-wedding-blush border-b border-wedding-gold/20">
        <div class="max-w-4xl mx-auto">
            <!-- Decorative Motif -->
            <div class="flex items-center justify-center space-x-3 mb-2 text-wedding-gold">
                <span class="h-[1px] w-12 bg-wedding-gold/40"></span>
                <i class="fa-solid fa-heart text-sm"></i>
                <i class="fa-solid fa-rings-wedding text-lg mx-1"></i>
                <i class="fa-solid fa-heart text-sm"></i>
                <span class="h-[1px] w-12 bg-wedding-gold/40"></span>
            </div>

            <p class="font-sans uppercase tracking-[0.3em] text-xs font-semibold text-wedding-burgundy/80 mb-1">Welcome to the Wedding of</p>
            <h1 class="font-cursive text-6xl md:text-8xl text-wedding-burgundy my-2 drop-shadow-sm">Siti & Harith</h1>
            
            <p class="font-serif text-lg md:text-xl text-wedding-dark/80 italic mt-1">"Two lives, two hearts, joined together in friendship, united forever in love."</p>

            <!-- Details Badge -->
            <div class="mt-4 flex flex-wrap items-center justify-center gap-4 text-xs font-medium text-wedding-burgundy/90">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/80 border border-wedding-rose/40 shadow-sm">
                    <i class="fa-regular fa-calendar-heart text-wedding-gold"></i> October 24, 2026
                </span>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/80 border border-wedding-rose/40 shadow-sm">
                    <i class="fa-solid fa-location-dot text-wedding-gold"></i> The Grand Botanical Estate, California
                </span>
            </div>

            <!-- Main Action Bar -->
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                <button onclick="openModal('uploadModal')" class="px-6 py-3 rounded-full bg-gradient-to-r from-wedding-burgundy to-wedding-burgundy/90 text-white font-medium shadow-md hover:shadow-lg hover:from-wedding-gold hover:to-wedding-gold/90 transition-all flex items-center gap-2 transform hover:-translate-y-0.5">
                    <i class="fa-solid fa-camera"></i>
                    <span>Share Photo & Wish</span>
                </button>
                <button onclick="openModal('noteModal')" class="px-5 py-3 rounded-full bg-white text-wedding-burgundy border border-wedding-burgundy/30 font-medium hover:bg-wedding-blush shadow-sm transition-all flex items-center gap-2">
                    <i class="fa-solid fa-pen-fancy text-wedding-gold"></i>
                    <span>Leave Message Only</span>
                </button>
                <button onclick="toggleSlideshow(true)" class="px-5 py-3 rounded-full bg-wedding-champagne text-wedding-burgundy border border-wedding-gold/40 font-medium hover:bg-wedding-goldLight shadow-sm transition-all flex items-center gap-2">
                    <i class="fa-solid fa-play"></i>
                    <span>Live Wall Projection</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Navigation & Filter Bar -->
    <section class="sticky top-0 z-20 glass-panel shadow-sm border-y border-wedding-gold/20 py-3 px-4">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            <!-- Filter Tabs -->
            <div class="flex items-center space-x-1 overflow-x-auto w-full md:w-auto pb-1 md:pb-0 scrollbar-none">
                <button onclick="setFilter('all')" id="tab-all" class="tab-btn px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all bg-wedding-burgundy text-white shadow-xs">
                    All Memories
                </button>
                <button onclick="setFilter('photos')" id="tab-photos" class="tab-btn px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all text-wedding-dark hover:bg-white/60">
                    <i class="fa-regular fa-image mr-1"></i> Photos
                </button>
                <button onclick="setFilter('notes')" id="tab-notes" class="tab-btn px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all text-wedding-dark hover:bg-white/60">
                    <i class="fa-regular fa-note-sticky mr-1"></i> Guestbook Messages
                </button>
                <button onclick="setFilter('popular')" id="tab-popular" class="tab-btn px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all text-wedding-dark hover:bg-white/60">
                    <i class="fa-solid fa-heart text-wedding-burgundy mr-1"></i> Most Loved
                </button>
            </div>

            <!-- Search & Controls -->
            <div class="flex items-center gap-2 w-full md:w-auto justify-end">
                <div class="relative w-full md:w-64">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-wedding-burgundy/40 text-xs"></i>
                    <input type="text" id="searchInput" oninput="handleSearch()" placeholder="Search guest or message..." class="w-full pl-8 pr-3 py-1.5 text-xs rounded-full bg-white/90 border border-wedding-rose/50 focus:outline-none focus:border-wedding-gold transition-all">
                </div>
                <button onclick="exportGuestbook()" title="Download Summary" class="p-2 rounded-full bg-white text-wedding-burgundy border border-wedding-rose/40 hover:bg-wedding-blush transition-all text-xs">
                    <i class="fa-solid fa-download"></i>
                </button>
                <button onclick="confirmReset()" title="Reset Demo Data" class="p-2 rounded-full bg-white text-wedding-burgundy/60 border border-wedding-rose/40 hover:text-wedding-burgundy hover:bg-wedding-blush transition-all text-xs">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Main Content Grid / Photo Wall -->
    <main class="max-w-6xl mx-auto px-4 py-8 z-10 relative">
        <div id="statsBar" class="mb-6 flex justify-between items-center text-xs text-wedding-dark/60 font-medium px-2">
            <span id="photoCountText">Displaying 0 memories</span>
            <span class="italic">Scan QR or tap 'Share Photo' to add yours!</span>
        </div>

        <!-- Masonry Grid Layout -->
        <div id="galleryGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <!-- Dynamic Content Injected Here -->
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-16 bg-white/50 rounded-2xl border border-dashed border-wedding-rose/60 max-w-md mx-auto my-8">
            <i class="fa-regular fa-images text-4xl text-wedding-rose mb-3"></i>
            <h3 class="font-serif text-xl text-wedding-burgundy font-semibold">No memories found</h3>
            <p class="text-xs text-wedding-dark/60 mt-1 max-w-xs mx-auto">Be the first to share a moment or message for Siti & Harith!</p>
            <button onclick="openModal('uploadModal')" class="mt-4 px-4 py-2 rounded-full bg-wedding-burgundy text-white text-xs font-medium">Add Photo</button>
        </div>
    </main>

    <!-- Footer -->
    <footer class="mt-16 py-8 border-t border-wedding-gold/20 text-center text-xs text-wedding-dark/60 z-10 relative bg-white/40">
        <p class="font-serif text-sm text-wedding-burgundy font-semibold">Siti & Harith' Wedding Guestbook</p>
        <p class="mt-1">Thank you for sharing our special day with us!</p>
    </footer>

    <!-- ================= MODALS ================= -->

    <!-- UPLOAD & CAMERA CAPTURE MODAL -->
    <div id="uploadModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="glass-panel w-full max-w-lg rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh] animate-in fade-in zoom-in duration-200">
            <!-- Modal Header -->
            <div class="px-6 py-4 border-b border-wedding-gold/20 flex justify-between items-center bg-white/80">
                <h3 class="font-serif text-xl text-wedding-burgundy font-bold flex items-center gap-2">
                    <i class="fa-solid fa-camera-retro text-wedding-gold"></i>
                    <span>Share Your Photo</span>
                </h3>
                <button onclick="closeModal('uploadModal')" class="text-wedding-dark/50 hover:text-wedding-burgundy transition-colors">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="p-6 overflow-y-auto space-y-4">
                <!-- Source Selection Tabs -->
                <div class="flex rounded-lg bg-wedding-blush p-1 border border-wedding-rose/30">
                    <button type="button" onclick="switchUploadSource('file')" id="sourceTabFile" class="flex-1 py-1.5 text-xs font-semibold rounded-md bg-white text-wedding-burgundy shadow-xs">
                        <i class="fa-solid fa-upload mr-1"></i> Upload File
                    </button>
                    <button type="button" onclick="switchUploadSource('camera')" id="sourceTabCamera" class="flex-1 py-1.5 text-xs font-semibold rounded-md text-wedding-dark/70 hover:text-wedding-burgundy">
                        <i class="fa-solid fa-video mr-1"></i> Live Camera
                    </button>
                </div>

                <!-- FILE UPLOAD SECTION -->
                <div id="fileUploadSection" class="space-y-3">
                    <div id="dropZone" class="border-2 border-dashed border-wedding-rose hover:border-wedding-gold rounded-xl p-6 text-center cursor-pointer transition-colors bg-white/50">
                        <input type="file" id="imageInput" accept="image/*" class="hidden" onchange="handleFileSelect(event)">
                        <i class="fa-solid fa-cloud-arrow-up text-3xl text-wedding-rose mb-2"></i>
                        <p class="text-xs font-medium text-wedding-burgundy">Tap to choose a photo or drag & drop</p>
                        <p class="text-[10px] text-wedding-dark/50 mt-1">PNG, JPG, WEBP up to 10MB</p>
                    </div>
                </div>

                <!-- LIVE CAMERA SECTION -->
                <div id="cameraSection" class="hidden space-y-3">
                    <div class="relative bg-black rounded-xl overflow-hidden aspect-4/3 flex items-center justify-center">
                        <video id="webcam" autoplay playsinline class="w-full h-full object-cover"></video>
                        <canvas id="cameraCanvas" class="hidden"></canvas>
                        
                        <!-- Camera Controls Overlay -->
                        <div class="absolute bottom-3 inset-x-0 flex justify-center items-center gap-4">
                            <button type="button" onclick="toggleCameraFacing()" class="p-2.5 rounded-full bg-black/50 text-white hover:bg-black/80 transition-all text-xs" title="Flip Camera">
                                <i class="fa-solid fa-camera-rotate"></i>
                            </button>
                            <button type="button" onclick="captureSnapshot()" class="shutter-btn w-12 h-12 rounded-full bg-wedding-gold border-2 border-white text-white flex items-center justify-center shadow-lg transform active:scale-95">
                                <i class="fa-solid fa-camera text-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- PREVIEW CONTAINER & FILTERS -->
                <div id="previewContainer" class="hidden space-y-3">
                    <div class="relative rounded-xl overflow-hidden border border-wedding-gold/30 bg-black max-h-56 flex items-center justify-center">
                        <img id="imagePreview" src="" alt="Preview" class="max-h-56 object-contain filter-normal">
                        <button type="button" onclick="clearSelectedImage()" class="absolute top-2 right-2 p-1.5 rounded-full bg-black/60 text-white hover:bg-black transition-all text-xs">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>

                    <!-- Filter Options -->
                    <div>
                        <label class="block text-[11px] font-semibold text-wedding-burgundy uppercase mb-1">Apply Photo Filter</label>
                        <div class="flex gap-2 overflow-x-auto pb-2">
                            <button type="button" onclick="applyFilter('filter-normal')" class="px-2.5 py-1 text-[11px] rounded bg-white border border-wedding-rose/40 whitespace-nowrap">Original</button>
                            <button type="button" onclick="applyFilter('filter-warm')" class="px-2.5 py-1 text-[11px] rounded bg-white border border-wedding-rose/40 whitespace-nowrap">Warm Romance</button>
                            <button type="button" onclick="applyFilter('filter-vintage')" class="px-2.5 py-1 text-[11px] rounded bg-white border border-wedding-rose/40 whitespace-nowrap">Vintage</button>
                            <button type="button" onclick="applyFilter('filter-bw')" class="px-2.5 py-1 text-[11px] rounded bg-white border border-wedding-rose/40 whitespace-nowrap">Classic B&W</button>
                            <button type="button" onclick="applyFilter('filter-vivid')" class="px-2.5 py-1 text-[11px] rounded bg-white border border-wedding-rose/40 whitespace-nowrap">Vivid Party</button>
                        </div>
                    </div>
                </div>

                <!-- FORM INPUTS -->
                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-wedding-burgundy mb-1">Your Name *</label>
                        <input type="text" id="guestName" placeholder="e.g. Aunt Clara & Uncle Bob" class="w-full px-3 py-2 text-xs rounded-lg border border-wedding-rose/50 bg-white/80 focus:outline-none focus:border-wedding-gold">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-wedding-burgundy mb-1">Message / Wish for the Couple</label>
                        <textarea id="guestCaption" rows="3" placeholder="Wishing you both a lifetime of happiness, laughter, and endless love..." class="w-full px-3 py-2 text-xs rounded-lg border border-wedding-rose/50 bg-white/80 focus:outline-none focus:border-wedding-gold"></textarea>
                    </div>
                    <!-- Sticker / Emoji Overlay Picker -->
                    <div>
                        <label class="block text-[11px] font-semibold text-wedding-burgundy uppercase mb-1">Add Sticker Badge</label>
                        <div class="flex gap-2">
                            <button type="button" onclick="selectBadge('')" class="badge-opt px-2.5 py-1 text-xs rounded border border-wedding-rose/40 bg-white">None</button>
                            <button type="button" onclick="selectBadge('💍 Wedding Guest')" class="badge-opt px-2.5 py-1 text-xs rounded border border-wedding-rose/40 bg-white">💍 Wedding Guest</button>
                            <button type="button" onclick="selectBadge('🥂 Cheers!')" class="badge-opt px-2.5 py-1 text-xs rounded border border-wedding-rose/40 bg-white">🥂 Cheers!</button>
                            <button type="button" onclick="selectBadge('❤️ Best Day Ever')" class="badge-opt px-2.5 py-1 text-xs rounded border border-wedding-rose/40 bg-white">❤️ Best Day Ever</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="px-6 py-3 border-t border-wedding-gold/20 bg-white/80 flex justify-end gap-2">
                <button type="button" onclick="closeModal('uploadModal')" class="px-4 py-2 text-xs rounded-full border border-wedding-rose/50 text-wedding-dark/70 hover:bg-wedding-blush">Cancel</button>
                <button type="button" onclick="submitPhotoPost()" class="px-5 py-2 text-xs rounded-full bg-wedding-burgundy text-white font-medium hover:bg-wedding-gold transition-colors">Post Memory</button>
            </div>
        </div>
    </div>

    <!-- TEXT NOTE ONLY MODAL -->
    <div id="noteModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="glass-panel w-full max-w-md rounded-2xl shadow-2xl overflow-hidden flex flex-col">
            <div class="px-6 py-4 border-b border-wedding-gold/20 flex justify-between items-center bg-white/80">
                <h3 class="font-serif text-xl text-wedding-burgundy font-bold flex items-center gap-2">
                    <i class="fa-solid fa-pen-fancy text-wedding-gold"></i>
                    <span>Leave a Guestbook Wish</span>
                </h3>
                <button onclick="closeModal('noteModal')" class="text-wedding-dark/50 hover:text-wedding-burgundy">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-wedding-burgundy mb-1">Your Name *</label>
                    <input type="text" id="noteGuestName" placeholder="e.g. Cousins Emily & Mark" class="w-full px-3 py-2 text-xs rounded-lg border border-wedding-rose/50 bg-white/80 focus:outline-none focus:border-wedding-gold">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-wedding-burgundy mb-1">Your Message *</label>
                    <textarea id="noteMessage" rows="4" placeholder="Write your heartfelt note for Siti & Harith..." class="w-full px-3 py-2 text-xs rounded-lg border border-wedding-rose/50 bg-white/80 focus:outline-none focus:border-wedding-gold"></textarea>
                </div>
            </div>

            <div class="px-6 py-3 border-t border-wedding-gold/20 bg-white/80 flex justify-end gap-2">
                <button type="button" onclick="closeModal('noteModal')" class="px-4 py-2 text-xs rounded-full border border-wedding-rose/50 text-wedding-dark/70 hover:bg-wedding-blush">Cancel</button>
                <button type="button" onclick="submitNotePost()" class="px-5 py-2 text-xs rounded-full bg-wedding-burgundy text-white font-medium hover:bg-wedding-gold transition-colors">Submit Wish</button>
            </div>
        </div>
    </div>

    <!-- FULLSCREEN LIGHTBOX MODAL -->
    <div id="lightboxModal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden flex items-center justify-center p-4">
        <button onclick="closeModal('lightboxModal')" class="absolute top-4 right-4 z-50 text-white/70 hover:text-white p-2 text-2xl">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="max-w-4xl w-full bg-white rounded-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row max-h-[90vh]">
            <!-- Image Area -->
            <div class="md:w-3/5 bg-black flex items-center justify-center relative min-h-[280px]">
                <img id="lightboxImg" src="" alt="Detail view" class="max-h-[80vh] w-full object-contain">
                <div id="lightboxBadge" class="absolute top-3 left-3 bg-wedding-gold/90 text-wedding-burgundy px-3 py-1 rounded-full text-xs font-bold shadow-md hidden"></div>
            </div>

            <!-- Details & Comments Area -->
            <div class="md:w-2/5 p-6 flex flex-col justify-between bg-wedding-blush/30 overflow-y-auto">
                <div>
                    <!-- Header info -->
                    <div class="flex items-center justify-between pb-3 border-b border-wedding-gold/20">
                        <div>
                            <h4 id="lightboxAuthor" class="font-serif text-xl font-bold text-wedding-burgundy"></h4>
                            <p id="lightboxTime" class="text-[10px] text-wedding-dark/50"></p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="deleteCurrentLightboxMemory()" class="px-3 py-1.5 rounded-full border border-red-200 text-red-600 hover:bg-red-50 text-xs font-semibold transition-all flex items-center gap-1" title="Delete memory">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                            <button id="lightboxLikeBtn" onclick="toggleLikeCurrent()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-wedding-rose/40 text-wedding-burgundy hover:bg-wedding-rose/20 text-xs font-semibold transition-all">
                                <i id="lightboxHeartIcon" class="fa-regular fa-heart text-wedding-burgundy"></i>
                                <span id="lightboxLikeCount">0</span>
                            </button>
                        </div>
                    </div>

                    <!-- Caption -->
                    <p id="lightboxCaption" class="mt-4 text-xs leading-relaxed text-wedding-dark/90 italic font-serif text-base"></p>

                    <!-- Comments Section -->
                    <div class="mt-6">
                        <h5 class="text-xs font-bold uppercase tracking-wider text-wedding-burgundy mb-2">Guest Comments</h5>
                        <div id="commentsList" class="space-y-2 max-h-40 overflow-y-auto pr-1 text-xs">
                            <!-- Comments populated dynamically -->
                        </div>
                    </div>
                </div>

                <!-- Add Comment Form -->
                <div class="mt-4 pt-3 border-t border-wedding-gold/20">
                    <form onsubmit="addComment(event)" class="flex gap-2">
                        <input type="text" id="commentAuthor" placeholder="Your Name" class="w-1/3 px-2 py-1.5 text-xs rounded border border-wedding-rose/40 focus:outline-none focus:border-wedding-gold">
