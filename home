            },
            {
                id: 'seed-4',
                type: 'photo',
                author: 'College Friends Crew',
                caption: 'The ultimate wedding of the decade! Thanks for the amazing open bar and cake! 🍰🎉',
                badge: '❤️ Best Day Ever',
                filterClass: 'filter-vivid',
                likes: 15,
                comments: [],
                timestamp: Date.now() - 3600000 * 1,
                imageData: 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="600" height="500" viewBox="0 0 600 500"><rect width="600" height="500" fill="%236B2D3A"/><circle cx="300" cy="250" r="150" fill="%23D4AF37" opacity="0.6"/><text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="sans-serif" font-size="24" fill="%23ffffff">Party on the Dance Floor! 🕺💃</text></svg>'
            }
        ];

        // Initialize Database & UI
        window.onload = async function() {
            initFloatingHearts();
            await initDB();
            loadGallery();
        };

        /* ================= INDEXED DB HELPERS ================= */
        function initDB() {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open(DB_NAME, DB_VERSION);
                request.onupgradeneeded = (e) => {
                    db = e.target.result;
                    if (!db.objectStoreNames.contains(STORE_NAME)) {
                        db.createObjectStore(STORE_NAME, { keyPath: 'id' });
                    }
                };
                request.onsuccess = (e) => {
                    db = e.target.result;
                    checkSeedData(resolve);
                };
                request.onerror = (e) => reject(e);
            });
        }

        async function checkSeedData(resolve) {
            const items = await getAllMemories();
            if (items.length === 0) {
                const tx = db.transaction(STORE_NAME, 'readwrite');
                const store = tx.objectStore(STORE_NAME);
                SAMPLE_MEMORIES.forEach(mem => store.add(mem));
                tx.oncomplete = () => resolve();
            } else {
                resolve();
            }
        }

        function getAllMemories() {
            return new Promise((resolve, reject) => {
                const transaction = db.transaction([STORE_NAME], 'readonly');
                const store = transaction.objectStore(STORE_NAME);

                const request = store.getAll(); // Retrieves all records in store

                request.onsuccess = () => {
                resolve(request.result || []);
                };

                request.onerror = (e) => {
                console.error('Fetch failed:', e.target.error);
                reject(e.target.error);
                };
            });
        }

        function saveMemory(memoryObj) {
            return new Promise((resolve) => {
                const tx = db.transaction(STORE_NAME, 'readwrite');
                const store = tx.objectStore(STORE_NAME);
                store.put(memoryObj);
                tx.oncomplete = () => resolve();
            });
        }

        /* ================= RENDER GALLERY ================= */
        async function loadGallery() {
            const grid = document.getElementById('galleryGrid');
            const emptyState = document.getElementById('emptyState');
            let memories = await getAllMemories();

            // Apply Search Query
            if (searchQuery.trim() !== '') {
                const q = searchQuery.toLowerCase();
                memories = memories.filter(m => 
                    m.author.toLowerCase().includes(q) || 
                    (m.caption && m.caption.toLowerCase().includes(q))
                );
            }

            // Apply Filters
            if (currentFilter === 'photos') {
                memories = memories.filter(m => m.type === 'photo');
            } else if (currentFilter === 'notes') {
                memories = memories.filter(m => m.type === 'note');
            } else if (currentFilter === 'popular') {
                memories.sort((a, b) => b.likes - a.likes);
            } else {
                // Default: Most recent first
                memories.sort((a, b) => b.timestamp - a.timestamp);
            }

            // Update stats
            document.getElementById('photoCountText').innerText = `Displaying ${memories.length} ${memories.length === 1 ? 'memory' : 'memories'}`;

            if (memories.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            // Render Cards
            grid.innerHTML = memories.map(m => createPolaroidCard(m)).join('');
        }

        function createPolaroidCard(m) {
            const formattedDate = new Date(m.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            if (m.type === 'note') {
                return `
                <div onclick="openLightbox('${m.id}')" class="polaroid-card p-5 rounded-2xl cursor-pointer bg-gradient-to-br from-white to-wedding-blush/40 border border-wedding-gold/20 flex flex-col justify-between h-64">
                    <div>
                        <div class="flex items-center justify-between text-wedding-gold mb-2">
                            <i class="fa-solid fa-quote-left text-lg"></i>
                            <span class="text-[10px] font-sans text-wedding-dark/40">${formattedDate}</span>
                        </div>
                        <p class="font-serif italic text-sm text-wedding-dark/90 line-clamp-5">"${escapeHtml(m.caption)}"</p>
                    </div>
                    <div class="pt-3 border-t border-wedding-rose/20 flex items-center justify-between">
                        <span class="font-serif font-bold text-xs text-wedding-burgundy truncate max-w-[130px]">— ${escapeHtml(m.author)}</span>
                        <div class="flex items-center gap-2">
                            <button onclick="event.stopPropagation(); handleDelete('${m.id}')" class="text-xs text-wedding-dark/40 hover:text-red-600 transition-colors" title="Delete post">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                            <button onclick="event.stopPropagation(); quickLike('${m.id}')" class="text-xs text-wedding-burgundy hover:scale-110 transition-transform flex items-center gap-1">
                                <i class="fa-solid fa-heart"></i>
                                <span>${m.likes}</span>
                            </button>
                        </div>
                    </div>
                </div>`;
            }

            return `
            <div onclick="openLightbox('${m.id}')" class="polaroid-card p-3 rounded-xl cursor-pointer border border-wedding-gold/20 flex flex-col bg-white">
                <div class="relative overflow-hidden rounded-lg bg-gray-100 aspect-4/3 mb-3">
                    <img src="${m.imageData}" alt="Guest memory" class="w-full h-full object-cover ${m.filterClass}">
                    ${m.badge ? `<span class="absolute top-2 left-2 bg-wedding-burgundy/90 text-white text-[9px] font-bold px-2 py-0.5 rounded-full backdrop-blur-xs">${m.badge}</span>` : ''}
                </div>
                <div class="px-1 flex-1 flex flex-col justify-between">
                    <div>
                        <h4 class="font-serif font-bold text-sm text-wedding-burgundy truncate">${escapeHtml(m.author)}</h4>
                        ${m.caption ? `<p class="font-serif italic text-xs text-wedding-dark/80 line-clamp-2 my-1">"${escapeHtml(m.caption)}"</p>` : ''}
                    </div>
                    <div class="flex justify-between items-center mt-2 pt-2 border-t border-wedding-blush text-[10px] text-wedding-dark/50">
                        <span>${formattedDate}</span>
                        <div class="flex items-center gap-2">
                            <button onclick="event.stopPropagation(); handleDelete('${m.id}')" class="text-xs text-wedding-dark/40 hover:text-red-600 transition-colors" title="Delete post">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                            <button onclick="event.stopPropagation(); quickLike('${m.id}')" class="text-xs text-wedding-burgundy font-semibold hover:scale-110 transition-transform flex items-center gap-1">
                                <i class="fa-solid fa-heart"></i>
                                <span>${m.likes}</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>`;
        }

        /* ================= LIGHTBOX & INTERACTIONS ================= */
        async function openLightbox(id) {
            const memories = await getAllMemories();
            const memory = memories.find(m => m.id === id);
            if (!memory) return;

            currentActiveMemoryId = id;
            const modal = document.getElementById('lightboxModal');
            const img = document.getElementById('lightboxImg');
            const badge = document.getElementById('lightboxBadge');

            if (memory.type === 'note') {
                img.src = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="600" height="500" viewBox="0 0 600 500"><rect width="600" height="500" fill="%23FDF0F0"/><text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="serif" font-size="28" fill="%236B2D3A">Guestbook Message 💌</text></svg>';
            } else {
                img.src = memory.imageData;
                img.className = `max-h-[80vh] w-full object-contain ${memory.filterClass || ''}`;
            }

            if (memory.badge) {
                badge.innerText = memory.badge;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }

            document.getElementById('lightboxAuthor').innerText = memory.author;
            document.getElementById('lightboxTime').innerText = new Date(memory.timestamp).toLocaleString();
            document.getElementById('lightboxCaption').innerText = memory.caption ? `"${memory.caption}"` : '';
            document.getElementById('lightboxLikeCount').innerText = memory.likes;

            renderComments(memory.comments || []);
            openModal('lightboxModal');
        }

        function renderComments(comments) {
            const list = document.getElementById('commentsList');
            if (!comments || comments.length === 0) {
                list.innerHTML = `<p class="text-[11px] text-wedding-dark/40 italic">No comments yet. Leave a sweet word!</p>`;
                return;
            }
            list.innerHTML = comments.map(c => `
                <div class="bg-white p-2 rounded border border-wedding-rose/20">
                    <span class="font-bold text-wedding-burgundy">${escapeHtml(c.author)}:</span>
                    <span class="text-wedding-dark/80">${escapeHtml(c.text)}</span>
                </div>
            `).join('');
        }

        async function quickLike(id) {
            const memories = await getAllMemories();
            const memory = memories.find(m => m.id === id);
            if (memory) {
                memory.likes += 1;
                await saveMemory(memory);
                loadGallery();
            }
        }

        async function toggleLikeCurrent() {
            if (!currentActiveMemoryId) return;
            await quickLike(currentActiveMemoryId);
            const memories = await getAllMemories();
            const memory = memories.find(m => m.id === currentActiveMemoryId);
            if (memory) {
                document.getElementById('lightboxLikeCount').innerText = memory.likes;
            }
        }

        async function addComment(e) {
            e.preventDefault();
            const authorInput = document.getElementById('commentAuthor');
            const textInput = document.getElementById('commentText');

            if (!authorInput.value.trim() || !textInput.value.trim()) return;

            const memories = await getAllMemories();
            const memory = memories.find(m => m.id === currentActiveMemoryId);
            if (memory) {
                if (!memory.comments) memory.comments = [];
                memory.comments.push({ author: authorInput.value.trim(), text: textInput.value.trim() });
                await saveMemory(memory);
                renderComments(memory.comments);
                textInput.value = '';
                loadGallery();
            }
        }

        /* ================= UPLOAD & CAMERA SYSTEM ================= */
        function switchUploadSource(source) {
            const fileSec = document.getElementById('fileUploadSection');
            const camSec = document.getElementById('cameraSection');
            const tabFile = document.getElementById('sourceTabFile');
            const tabCam = document.getElementById('sourceTabCamera');

            if (source === 'file') {
                fileSec.classList.remove('hidden');
                camSec.classList.add('hidden');
                tabFile.className = "flex-1 py-1.5 text-xs font-semibold rounded-md bg-white text-wedding-burgundy shadow-xs";
                tabCam.className = "flex-1 py-1.5 text-xs font-semibold rounded-md text-wedding-dark/70 hover:text-wedding-burgundy";
                stopCamera();
            } else {
                fileSec.classList.add('hidden');
                camSec.classList.remove('hidden');
                tabCam.className = "flex-1 py-1.5 text-xs font-semibold rounded-md bg-white text-wedding-burgundy shadow-xs";
                tabFile.className = "flex-1 py-1.5 text-xs font-semibold rounded-md text-wedding-dark/70 hover:text-wedding-burgundy";
                startCamera();
            }
        }

        async function startCamera() {
            try {
                cameraStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: currentFacingMode, width: { ideal: 1280 }, height: { ideal: 960 } },
                    audio: false
                });
                document.getElementById('webcam').srcObject = cameraStream;
            } catch (err) {
                alert("Camera access denied or unavailable on this device.");
            }
        }

        function stopCamera() {
            if (cameraStream) {
                cameraStream.getTracks().forEach(track => track.stop());
                cameraStream = null;
            }
        }

        function toggleCameraFacing() {
            currentFacingMode = currentFacingMode === 'user' ? 'environment' : 'user';
            stopCamera();
            startCamera();
        }

        function captureSnapshot() {
            const video = document.getElementById('webcam');
            const canvas = document.getElementById('cameraCanvas');
            canvas.width = video.videoWidth || 640;
            canvas.height = video.videoHeight || 480;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            currentImageBase64 = canvas.toDataURL('image/jpeg', 0.85);

            showImagePreview(currentImageBase64);
            stopCamera();
            document.getElementById('cameraSection').classList.add('hidden');
        }

        function handleFileSelect(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                currentImageBase64 = e.target.result;
                showImagePreview(currentImageBase64);
            };
            reader.readAsDataURL(file);
        }

        function showImagePreview(url) {
            const previewContainer = document.getElementById('previewContainer');
            const img = document.getElementById('imagePreview');
            img.src = url;
            previewContainer.classList.remove('hidden');
        }

        function clearSelectedImage() {
            currentImageBase64 = null;
            document.getElementById('previewContainer').classList.add('hidden');
            document.getElementById('imageInput').value = '';
        }

        function applyFilter(filterClass) {
            selectedFilterClass = filterClass;
            const img = document.getElementById('imagePreview');
            img.className = `max-h-56 object-contain ${filterClass}`;
        }

        function selectBadge(badgeText) {
            selectedBadgeText = badgeText;
            document.querySelectorAll('.badge-opt').forEach(btn => {
                if (btn.innerText.includes(badgeText) || (badgeText === '' && btn.innerText === 'None')) {
                    btn.classList.add('bg-wedding-burgundy', 'text-white');
                    btn.classList.remove('bg-white');
                } else {
                    btn.classList.remove('bg-wedding-burgundy', 'text-white');
                    btn.classList.add('bg-white');
                }
            });
        }

        async function submitPhotoPost() {
            const author = document.getElementById('guestName').value.trim();
            const caption = document.getElementById('guestCaption').value.trim();

            if (!author) {
                alert("Please enter your name!");
                return;
            }
            if (!currentImageBase64) {
                alert("Please upload or take a photo first!");
                return;
            }

            const newMemory = {
                id: 'mem-' + Date.now(),
                type: 'photo',
                author: author,
                caption: caption,
                badge: selectedBadgeText,
                filterClass: selectedFilterClass,
                likes: 1,
                comments: [],
                timestamp: Date.now(),
                imageData: currentImageBase64
            };

            await saveMemory(newMemory);
            closeModal('uploadModal');
            resetUploadForm();
            loadGallery();
        }

        async function submitNotePost() {
            const author = document.getElementById('noteGuestName').value.trim();
            const message = document.getElementById('noteMessage').value.trim();

            if (!author || !message) {
                alert("Please enter both your name and message!");
                return;
            }

            const newMemory = {
                id: 'note-' + Date.now(),
                type: 'note',
                author: author,
                caption: message,
                badge: '',
                filterClass: '',
                likes: 1,
                comments: [],
                timestamp: Date.now(),
                imageData: null
            };

            await saveMemory(newMemory);
            closeModal('noteModal');
            document.getElementById('noteGuestName').value = '';
            document.getElementById('noteMessage').value = '';
            loadGallery();
        }

        function resetUploadForm() {
            document.getElementById('guestName').value = '';
            document.getElementById('guestCaption').value = '';
            clearSelectedImage();
            selectedBadgeText = '';
            selectedFilterClass = 'filter-normal';
            stopCamera();
        }

        /* ================= PROJECTION SLIDESHOW MODE ================= */
        async function toggleSlideshow(show) {
            const overlay = document.getElementById('slideshowOverlay');
            if (show) {
                overlay.classList.remove('hidden');
                currentSlideIndex = 0;
                slideshowPlaying = true;
                await updateSlideContent();
                slideshowInterval = setInterval(nextSlide, 5000);
            } else {
                overlay.classList.add('hidden');
                if (slideshowInterval) clearInterval(slideshowInterval);
            }
        }

        function toggleSlideshowPlay() {
            slideshowPlaying = !slideshowPlaying;
            const btn = document.getElementById('slideshowPauseBtn');
            if (slideshowPlaying) {
                btn.innerHTML = `<i class="fa-solid fa-pause"></i> Pause`;
                slideshowInterval = setInterval(nextSlide, 5000);
            } else {
                btn.innerHTML = `<i class="fa-solid fa-play"></i> Resume`;
                if (slideshowInterval) clearInterval(slideshowInterval);
            }
        }

        async function nextSlide() {
            const memories = await getAllMemories();
            if (memories.length === 0) return;
            currentSlideIndex = (currentSlideIndex + 1) % memories.length;
            updateSlideContent();
        }

        async function prevSlide() {
            const memories = await getAllMemories();
            if (memories.length === 0) return;
            currentSlideIndex = (currentSlideIndex - 1 + memories.length) % memories.length;
            updateSlideContent();
        }

        async function updateSlideContent() {
            const memories = await getAllMemories();
            if (memories.length === 0) return;

            const m = memories[currentSlideIndex];
            const card = document.getElementById('slideshowCard');
            const mediaContainer = document.getElementById('slideshowMedia');

            // Fade animation trigger
            card.classList.remove('scale-100', 'opacity-100');
            card.classList.add('scale-95', 'opacity-0');

            setTimeout(() => {
                if (m.type === 'photo') {
                    mediaContainer.innerHTML = `<img src="${m.imageData}" class="max-h-[55vh] object-contain ${m.filterClass || ''}">`;
                } else {
                    mediaContainer.innerHTML = `
                        <div class="p-8 text-wedding-burgundy">
                            <i class="fa-solid fa-quote-left text-4xl mb-2 text-wedding-gold"></i>
                            <p class="font-serif italic text-2xl">"${m.caption}"</p>
                        </div>
                    `;
                }

                document.getElementById('slideshowAuthor').innerText = m.author;
                document.getElementById('slideshowCaption').innerText = m.type === 'photo' && m.caption ? `"${m.caption}"` : '';
                document.getElementById('slideshowBadge').innerText = m.badge || '💍 Wedding Guestbook';

                card.classList.remove('scale-95', 'opacity-0');
                card.classList.add('scale-100', 'opacity-100');
            }, 300);
        }

        /* ================= EXPORT & RESET UTILS ================= */
        async function exportGuestbook() {
            const memories = await getAllMemories();
            let summaryText = `SITI & HARITH WEDDING GUESTBOOK SUMMARY\n`;
            summaryText += `==========================================\n\n`;

            memories.forEach((m, idx) => {
                summaryText += `${idx + 1}. FROM: ${m.author}\n`;
                summaryText += `   DATE: ${new Date(m.timestamp).toLocaleString()}\n`;
                summaryText += `   TYPE: ${m.type.toUpperCase()}\n`;
                summaryText += `   MESSAGE: "${m.caption || 'N/A'}"\n`;
                summaryText += `   LIKES: ${m.likes}\n\n`;
            });

            const blob = new Blob([summaryText], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'Siti_Harith_Wedding_Guestbook.txt';
            a.click();
            URL.revokeObjectURL(url);
        }

        async function confirmReset() {
            if (confirm("Reset demo data to initial sample photos and messages?")) {
                const tx = db.transaction(STORE_NAME, 'readwrite');
                const store = tx.objectStore(STORE_NAME);
                await store.clear();
                SAMPLE_MEMORIES.forEach(mem => store.add(mem));
                tx.oncomplete = () => {
                    loadGallery();
                };
            }
        }

        /* ================= GENERAL UI UTILS ================= */
        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
            if (id === 'uploadModal') stopCamera();
        }

        function setFilter(filterType) {
            currentFilter = filterType;
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = "tab-btn px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all text-wedding-dark hover:bg-white/60";
            });
            const activeTab = document.getElementById(`tab-${filterType}`);
            if (activeTab) {
                activeTab.className = "tab-btn px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider transition-all bg-wedding-burgundy text-white shadow-xs";
            }
            loadGallery();
        }

        function handleSearch() {
            searchQuery = document.getElementById('searchInput').value;
            loadGallery();
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function initFloatingHearts() {
            const container = document.getElementById('floating-hearts-container');
            const hearts = ['🌸', '✨', '💍', '💖', '🥂'];
            for (let i = 0; i < 15; i++) {
                const el = document.createElement('div');
                el.className = 'floating-heart';
                el.innerText = hearts[Math.floor(Math.random() * hearts.length)];
                el.style.left = `${Math.random() * 100}vw`;
                el.style.animationDuration = `${6 + Math.random() * 6}s`;
                el.style.animationDelay = `${Math.random() * 5}s`;
                el.style.fontSize = `${14 + Math.random() * 12}px`;
                container.appendChild(el);
            }
        }

        function deleteMemory(id) {
            return new Promise((resolve, reject) => {
                const transaction = db.transaction([STORE_NAME], 'readwrite');
                const store = transaction.objectStore(STORE_NAME);

                const request = store.delete(id);

                request.onsuccess = () => {
                console.log(`Item ${id} deleted.`);
                resolve();
                };

                request.onerror = (e) => {
                reject(e.target.error);
                };
            });
        }

        async function handleDelete(id) {
            if (confirm("Are you sure you want to delete this memory?")) {
                await deleteMemory(id);
                loadGallery();
            }
        }

        async function deleteCurrentLightboxMemory() {
            if (!currentActiveMemoryId) return;
            if (confirm("Are you sure you want to delete this memory?")) {
                await deleteMemory(currentActiveMemoryId);
                closeModal('lightboxModal');
                loadGallery();
            }
        }
    </script>
</body>
</html>
