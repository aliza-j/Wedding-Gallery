    <!-- ================= JAVASCRIPT LOGIC ================= -->
    <script>
        // IndexedDB Configuration
        const DB_NAME = 'WeddingGuestbookDB';
        const DB_VERSION = 1;
        const STORE_NAME = 'memories';
        let db = null;

        // Application State
        let currentFilter = 'all';
        let searchQuery = '';
        let currentActiveMemoryId = null;
        let selectedBadgeText = '';
        let selectedFilterClass = 'filter-normal';
        let cameraStream = null;
        let currentFacingMode = 'user';
        let currentImageBase64 = null;
        let slideshowInterval = null;
        let slideshowPlaying = true;
        let currentSlideIndex = 0;

        // Initial Seed Data
        const SAMPLE_MEMORIES = [
            {
                id: 'seed-1',
                type: 'photo',
                author: 'Elena & Lucas (Maid of Honor)',
                caption: 'To the most gorgeous bride and handsome groom! So honoured to celebrate this beautiful day with you both! ❤️✨',
                badge: '💍 Wedding Guest',
                filterClass: 'filter-warm',
                likes: 12,
                comments: [{ author: 'Siti (Bride)', text: 'Love you so much Elena!! 💕' }],
                timestamp: Date.now() - 3600000 * 5,
                // Sample placeholder inline data URL with nice wedding colors
                imageData: 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="600" height="500" viewBox="0 0 600 500"><rect width="600" height="500" fill="%23F3E5AB"/><circle cx="300" cy="200" r="120" fill="%23E8B4B8"/><text x="50%" y="45%" dominant-baseline="middle" text-anchor="middle" font-family="serif" font-size="28" fill="%236B2D3A">Siti %26 Harith</text><text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" font-family="sans-serif" font-size="16" fill="%232C2224">First Dance Magic 🥂</text></svg>'
            },
            {
                id: 'seed-2',
                type: 'photo',
                author: 'Uncle David & Family',
                caption: 'Wishing you a lifetime of love and joy. Welcome to the family Harith!',
                badge: '🥂 Cheers!',
                filterClass: 'filter-normal',
                likes: 8,
                comments: [],
                timestamp: Date.now() - 3600000 * 3,
                imageData: 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="600" height="500" viewBox="0 0 600 500"><rect width="600" height="500" fill="%23FDF0F0"/><rect x="100" y="80" width="400" height="340" rx="20" fill="%238A9A86"/><text x="50%" y="48%" dominant-baseline="middle" text-anchor="middle" font-family="serif" font-size="26" fill="%23ffffff">Garden Reception 🎉</text></svg>'
            },
            {
                id: 'seed-3',
                type: 'note',
